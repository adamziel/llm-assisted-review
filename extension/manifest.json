{
  "manifest_version": 3,
  "name": "GitHub Triage Copilot",
  "description": "Local-first triage suggestions for GitHub issues and pull requests.",
  "version": "0.1.0",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1:8765/*",
    "http://localhost:8765/*",
    "https://github.com/WordPress/wordpress-playground/*",
    "https://github.com/wordpress/wordpress-playground/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://github.com/WordPress/wordpress-playground/issues*",
        "https://github.com/WordPress/wordpress-playground/pull*",
        "https://github.com/wordpress/wordpress-playground/issues*",
        "https://github.com/wordpress/wordpress-playground/pull*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "homepage_url": "https://github.com/adamziel/llm-assisted-review"
}
